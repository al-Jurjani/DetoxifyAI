name: mlflow_test_experiment_1

conda_env: requirements.txt

entry_points:
  main:
    parameters:
      preprocessor: {type: string, default: "aggressive"}
      model_type: {type: string, default: "xgboost"}
      ngram: {type: string, default: "(1,2)"}
      max_features: {type: int, default: 100000}

      # Logistic Regression parameters
      # logreg_C: {type: float, default: 1.0}
      # logreg_penalty: {type: string, default: "l2"}
      # logreg_max_iter: {type: int, default: 1000}
      
      # XGBoost parameters
      xgb_eta: {type: float, default: 0.7}
      xgb_n_estimators: {type: int, default: 1000}
      xgb_max_depth: {type: int, default: 4}
      xgb_colsample_bytree: {type: float, default: 0.6}


      # --logreg_C {logreg_C}
      # --logreg_penalty {logreg_penalty}
      # --logreg_max_iter {logreg_max_iter}
    command: >
      python train.py
      --preprocessor {preprocessor}
      --model_type {model_type}
      --ngram {ngram}
      --max_features {max_features}

      --xgb_eta {xgb_eta}
      --xgb_n_estimators {xgb_n_estimators}
      --xgb_max_depth {xgb_max_depth}
      --xgb_colsample_bytree {xgb_colsample_bytree}
